 "comment_lines": [
  {
   "text": "The Sales Admin team responds quickly to price and shipment inquiries, but during month-end it is"
  },
  {
   "text": "difficult to reach the team by phone. We would appreciate a dedicated e-mail channel with same-day"
  },
  {
   "text": "replies. Shipping documents (B/L, invoice, packing list and certificate of origin) should be sent at"
  },
  {
   "text": "least three working days before vessel arrival so our customs broker can prepare clearance in time."
  },
  {
   "text": "Please also share the vessel schedule and any changes to the loading port or ETD as early as possible,"
  },
  {
   "text": "and provide a monthly summary of orders, shipments and outstanding documents by e-mail. Draft documents"
  },
  {
   "text": "for checking before final issue would help us avoid amendment fees. Finally, a single contact person for"
  },
  {
   "text": "claims on damaged bags would make issue resolution faster and more consistent."
  }
 ],
