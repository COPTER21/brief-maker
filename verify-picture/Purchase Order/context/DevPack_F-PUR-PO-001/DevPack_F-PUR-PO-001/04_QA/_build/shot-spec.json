{
 "html": "F-PUR-PO.html",
 "vw": 1200,
 "vh": 1000,
 "device_scale": 2,
 "wait": 420,
 "shots": [
  {
   "key": "list_overview",
   "setup": [],
   "container": "#page-content",
   "target": {
    "selector": ".stats"
   }
  },
  {
   "key": "list_table",
   "setup": [],
   "container": "#page-content",
   "target": {
    "selector": ".table-wrap"
   }
  },
  {
   "key": "list_filter",
   "setup": [],
   "container": "#page-content",
   "target": {
    "selector": ".filter-bar"
   }
  },
  {
   "key": "list_rowmenu",
   "setup": [
    "(()=>{const r=[...document.querySelectorAll('tbody tr')].pop();r.querySelector('[onclick*=openRowMenu]').click();})()"
   ],
   "container": "body",
   "target": {
    "selector": ".row-menu"
   }
  },
  {
   "key": "wizard_step1",
   "setup": [
    "openCreateDrawer()"
   ],
   "container": ".drawer-panel",
   "target": {
    "selector": ".drawer-body"
   }
  },
  {
   "key": "wizard_step2",
   "setup": [
    "openCreateDrawer()",
    "gotoStep(2)"
   ],
   "container": ".drawer-panel",
   "target": {
    "selector": ".form-grid"
   }
  },
  {
   "key": "wizard_step3_lines",
   "setup": [
    "openCreateDrawer()",
    "gotoStep(3)"
   ],
   "container": ".drawer-panel",
   "target": {
    "selector": ".line-tbl"
   }
  },
  {
   "key": "wizard_step3_expand",
   "setup": [
    "openCreateDrawer()",
    "gotoStep(3)",
    "(()=>{const i=document.querySelector('[id^=item-input-]');if(i)toggleLineExpand(i.id.replace('item-input-',''));})()"
   ],
   "container": ".drawer-panel",
   "target": {
    "selector": ".line-expand-panel-anchor"
   }
  },
  {
   "key": "wizard_step4_upload",
   "setup": [
    "openCreateDrawer()",
    "gotoStep(4)"
   ],
   "container": ".drawer-panel",
   "target": {
    "selector": ".upload-zone"
   }
  },
  {
   "key": "wizard_step5_review",
   "setup": [
    "openCreateDrawer()",
    "gotoStep(5)"
   ],
   "container": ".drawer-panel",
   "target": {
    "selector": ".drawer-body"
   }
  },
  {
   "key": "wizard_footer",
   "setup": [
    "openCreateDrawer()",
    "gotoStep(5)"
   ],
   "container": ".drawer-panel",
   "target": {
    "selector": ".dw-footer"
   }
  },
  {
   "key": "combo_vendor",
   "setup": [
    "openCreateDrawer()",
    "gotoStep(2)",
    "comboOpen('vendor','')"
   ],
   "container": "body",
   "target": {
    "selector": "#combo-pop"
   }
  },
  {
   "key": "combo_person",
   "setup": [
    "openCreateDrawer()",
    "gotoStep(2)",
    "comboOpen('buyer','')"
   ],
   "container": "body",
   "target": {
    "selector": "#combo-pop"
   }
  },
  {
   "key": "view_tabs",
   "setup": [
    "openViewDrawer(POS.find(p=>p.status==='sent').id)"
   ],
   "container": ".drawer-panel",
   "target": {
    "selector": ".drawer-tabs"
   }
  },
  {
   "key": "view_detail",
   "setup": [
    "openViewDrawer(POS.find(p=>p.status==='sent').id)"
   ],
   "container": ".drawer-panel",
   "target": {
    "selector": ".dv-body"
   }
  },
  {
   "key": "view_recv",
   "setup": [
    "openViewDrawer(POS.find(p=>p.status==='partially_received').id)",
    "setViewTab('recv')"
   ],
   "container": ".drawer-panel",
   "target": {
    "selector": ".dv-body"
   }
  },
  {
   "key": "view_pdf",
   "setup": [
    "openViewDrawer(POS.find(p=>p.status==='sent').id)",
    "setViewTab('pdf')"
   ],
   "container": ".drawer-panel",
   "target": {
    "selector": ".a4"
   }
  },
  {
   "key": "view_sign",
   "setup": [
    "openViewDrawer(POS.find(p=>p.status==='pending_approval').id)",
    "setViewTab('sign')"
   ],
   "container": ".drawer-panel",
   "target": {
    "selector": ".dv-body"
   }
  },
  {
   "key": "view_history",
   "setup": [
    "openViewDrawer(POS.find(p=>p.status==='sent').id)",
    "setViewTab('history')"
   ],
   "container": ".drawer-panel",
   "target": {
    "selector": ".dv-body"
   }
  },
  {
   "key": "view_closed",
   "setup": [
    "openViewDrawer(POS.find(p=>p.status==='closed').id)"
   ],
   "container": ".drawer-panel",
   "target": {
    "selector": ".dv-head"
   }
  },
  {
   "key": "view_partial_head",
   "setup": [
    "openViewDrawer(POS.find(p=>p.status==='partially_received').id)"
