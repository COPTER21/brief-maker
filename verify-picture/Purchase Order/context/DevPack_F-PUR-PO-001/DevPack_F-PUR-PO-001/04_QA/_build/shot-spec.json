    "openSubmitModal(POS.find(p=>p.status==='draft').id)"
   ],
   "container": ".modal-overlay",
   "target": {
    "selector": ".slot-row"
   }
  },
  {
   "key": "modal_approve",
   "setup": [
    "openViewDrawer(POS.find(p=>p.status==='pending_approval').id)",
    "openApproveModal(POS.find(p=>p.status==='pending_approval').id)"
   ],
