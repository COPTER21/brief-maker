   }
  },
  {
   "key": "modal_send",
   "setup": [
    "openViewDrawer(POS.find(p=>p.status==='sent').id)",
    "openSendModal(POS.find(p=>p.status==='sent').id)"
   ],
   "container": ".modal-overlay",
   "target": {
    "selector": ".card"
   }
  }
 ]
}