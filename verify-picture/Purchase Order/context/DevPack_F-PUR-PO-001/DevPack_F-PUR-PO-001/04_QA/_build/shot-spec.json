   "container": ".modal-overlay",
   "target": {
    "selector": ".card"
   }
  },
  {
   "key": "modal_cancel",
   "setup": [
    "openViewDrawer(POS.find(p=>p.status==='sent').id)",
    "openCancelModal(POS.find(p=>p.status==='sent').id)"
   ],
   "container": ".modal-overlay",
   "target": {
