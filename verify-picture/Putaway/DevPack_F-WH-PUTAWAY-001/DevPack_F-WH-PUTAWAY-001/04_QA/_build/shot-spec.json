{
  "html": "F-WH-PUTAWAY.html",
  "vw": 1440,
  "vh": 1000,
  "device_scale": 2,
  "shots": [
    {
      "key": "queue_console",
      "setup": ["setView('queue')"],
      "wait": 500,
      "container": "#page-content",
      "target": { "selector": ".stats" }
    },
    {
      "key": "queue_aging",
      "setup": ["setView('queue')", "qfReset()"],
      "wait": 500,
      "container": ".run-aside",
      "target": { "selector": ".aside-list" }
    },
    {
      "key": "queue_filters",
      "setup": ["setView('queue')"],
      "wait": 450,
      "container": ".run-aside",
      "target": { "selector": ".aside-tools" }
    },
    {
      "key": "runner_head",
      "setup": ["pickTask(TASKS.find(t=>t.status==='wait'&&taskKind(t)==='normal').id)"],
      "wait": 500,
      "container": ".run-main",
      "target": { "selector": ".kv" }
    },
    {
      "key": "runner_suggest",
      "setup": ["pickTask(TASKS.find(t=>t.status==='wait'&&taskKind(t)==='normal').id)"],
      "wait": 500,
      "container": ".run-main",
      "target": { "selector": ".sug-grid" }
    },
    {
      "key": "runner_claimed",
      "setup": ["pickTask(TASKS.find(t=>t.status==='wait'&&taskKind(t)==='normal').id)", "claimTask()"],
      "wait": 500,
      "container": ".run-main",
      "target": { "selector": ".rh-acts" }
    },
    {
      "key": "dest_table",
      "setup": ["pickTask(TASKS.find(t=>t.status==='wait'&&taskKind(t)==='normal').id)", "claimTask()", "fillAll()"],
      "wait": 500,
      "container": ".run-main",
      "target": { "selector": ".rsec", "has_text": "ปลายทางที่จะจัดเก็บ" }
    },
    {
      "key": "dest_split",
      "setup": ["pickTask(TASKS.find(t=>t.status==='wait'&&taskKind(t)==='normal').id)", "claimTask()", "fillAll()", "setDestQty(0,60)", "addDest()", "chooseBin('B-01-02-A')", "setDestQty(1,40)"],
      "wait": 550,
      "container": ".run-main",
      "target": { "selector": ".rsec", "has_text": "ปลายทางที่จะจัดเก็บ" }
    },
    {
      "key": "qty_blocked",
      "setup": ["pickTask(TASKS.find(t=>t.status==='wait'&&taskKind(t)==='normal').id)", "claimTask()", "fillAll()", "setDestQty(0,150)"],
      "wait": 550,
      "container": ".run-main",
      "target": { "selector": ".warnbox.is-stop" }
    },
    {
      "key": "override_reason",
      "setup": ["pickTask(TASKS.find(t=>t.status==='wait'&&taskKind(t)==='normal').id)", "claimTask()", "fillAll()", "chooseBin('A-01-01-A')"],
      "wait": 550,
      "container": ".run-main",
      "target": { "selector": ".rsec", "has_text": "ปลายทางที่จะจัดเก็บ" }
    },
    {
      "key": "over_capacity",
      "setup": ["pickTask(TASKS.find(t=>t.name.indexOf('กระเบื้อง')>=0&&t.status==='wait').id)", "claimTask()", "fillAll()"],
      "wait": 550,
      "container": ".run-main",
      "target": { "selector": ".rsec", "has_text": "ปลายทางที่จะจัดเก็บ" }
    },
    {
      "key": "actor_picker",
      "setup": ["pickTask(TASKS.find(t=>t.status==='wait'&&taskKind(t)==='normal').id)", "claimTask()"],
      "wait": 500,
      "container": ".run-main",
      "target": { "selector": ".rsec", "has_text": "ผู้จัดเก็บ และ หมายเหตุ" }
    },
    {
      "key": "confirm_bar",
      "setup": ["pickTask(TASKS.find(t=>t.status==='wait'&&taskKind(t)==='normal').id)", "claimTask()", "fillAll()"],
      "wait": 500,
      "container": ".run-main",
      "target": { "selector": ".cbar" }
    },
    {
      "key": "quarantine_queue",
      "setup": ["setView('queue')", "qfSet('kind','quarantine')"],
      "wait": 500,
      "container": ".run-aside",
      "target": { "selector": ".aside-list" }
    },
    {
      "key": "quarantine_runner",
      "setup": ["pickTask(TASKS.find(t=>taskKind(t)==='quarantine').id)"],
      "wait": 550,
      "container": ".run-main",
      "target": { "selector": ".warnbox" }
    },
    {
      "key": "no_suggestion",
      "setup": ["pickTask(TASKS.find(t=>t.status!=='void'&&suggestBins(t).length===0).id)"],
      "wait": 550,
      "container": ".run-main",
      "target": { "selector": ".warnbox.is-stop" }
    },
    {
      "key": "bins_map",
      "setup": ["setView('bins')"],
      "wait": 500,
      "container": "#page-content",
      "target": { "selector": ".table" }
    },
    {
      "key": "bin_cards",
      "setup": ["setView('bins')", "toggleZoneRow('WH-BKK-01/B')"],
      "wait": 550,
      "container": "#page-content",
      "target": { "selector": ".bin-grid" }
    },
    {
      "key": "lock_modal",
      "setup": ["setView('bins')", "toggleZoneRow('WH-BKK-01/B')", "askLockBin('B-01-02-A')"],
      "wait": 550,
      "container": ".modal",
      "target": { "selector": ".field" }
    },
    {
      "key": "history_table",
      "setup": ["setView('history')"],
      "wait": 500,
      "container": "#page-content",
      "target": { "selector": ".table" }
    },
    {
      "key": "history_expanded",
      "setup": ["setView('history')", "toggleHistRow(MOVES.find(m=>m.kind!=='rev').id)"],
      "wait": 550,
      "container": "#page-content",
      "target": { "selector": ".line-expanded" }
    },
    {
      "key": "reverse_modal",
      "setup": ["setView('history')", "askReverse(MOVES.find(m=>m.kind!=='rev'&&!m.revBy).id)"],
      "wait": 550,
      "container": ".modal",
      "target": { "selector": ".field" }
    },
    {
      "key": "sidebar_nav",
      "setup": ["setView('queue')"],
      "wait": 450,
      "container": ".sidebar",
      "target": { "selector": ".sb-features" }
    }
  ]
}
