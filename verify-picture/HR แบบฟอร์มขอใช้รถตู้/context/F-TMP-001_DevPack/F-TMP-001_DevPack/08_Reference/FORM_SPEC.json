  "anomalies": [
    { "where": "ช่องลงชื่อผู้จัดการฝ่ายทรัพยากรบุคคล",
      "detail": "ต้นฉบับพิมพ์ชื่อบุคคลจริงไว้ตายตัวใต้ช่องลงชื่อ",
      "rule": "ชื่อผู้พิจารณาต้องมาจาก DOA resolve ตอนส่ง ห้าม hardcode ชื่อบุคคล และเป็นข้อมูลส่วนบุคคล (ห้ามใช้เป็นข้อมูลตัวอย่าง)" },
    { "where": "ช่วงวันที่ขอใช้รถตู้",
      "detail": "ต้นฉบับให้ผู้ขอกรอกจำนวนวันเอง ซึ่งอาจไม่ตรงกับช่วงวันที่ที่กรอก",
      "rule": "ระบบคำนวณจำนวนวันจากช่วงวันที่ และบล็อกเมื่อถึงวันที่ ก่อน วันที่เริ่ม" },
    { "where": "ลักษณะการเดินทาง vs ช่องสถานที่/เวลา",
      "detail": "ต้นฉบับมีช่องขาไปและขากลับครบเสมอ แม้ติ๊กเดินทางเฉพาะขาเดียว",
      "rule": "ติ๊กเฉพาะขาไป → ต้องกรอกเฉพาะบล็อกขาไป · เฉพาะขากลับ → เฉพาะบล็อกขากลับ · ไป-กลับ → ครบทั้งสองบล็อก" }
  ]
