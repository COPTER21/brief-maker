{
  "html": "F-WH-GRN.html",
  "vw": 1440,
  "vh": 940,
  "device_scale": 2,
  "shots": [
    {
      "key": "list_page",
      "setup": [],
      "wait": 700,
      "container": "#page-content",
      "target": {
        "selector": "table"
      }
    },
    {
      "key": "list_filters",
      "setup": [],
      "wait": 600,
      "container": "#page-content",
      "target": {
        "selector": ".filter-bar"
      }
    },
    {
      "key": "list_kpi",
      "setup": [],
      "wait": 600,
      "container": "#page-content",
      "target": {
        "selector": ".stats"
      }
    },
    {
      "key": "w1_tiles",
      "setup": [
        "openCreateDrawer()"
      ],
      "wait": 700,
      "container": "#create-drawer",
      "target": {
        "selector": ".tile-btn",
        "has_text": "จากใบสั่งซื้อ"
      }
    },
    {
      "key": "w1_blocked_po",
      "setup": [
        "openCreateDrawer()"
      ],
      "wait": 700,
      "container": "#create-drawer",
      "target": {
        "selector": ".po-pick.off"
      }
    },
    {
      "key": "w2_form",
      "setup": [
        "openCreateDrawer()",
        "pickPo(POS.find(poSelectable).code)",
        "createWizard.step=2;renderCreateDrawer()"
      ],
      "wait": 700,
      "container": "#create-drawer",
      "target": {
        "selector": ".form-grid"
      }
    },
    {
      "key": "w3_table",
      "setup": [
        "openCreateDrawer()",
        "pickPo(POS.find(poSelectable).code)",
        "createWizard.step=3;renderCreateDrawer()"
      ],
      "wait": 700,
      "container": "#create-drawer",
      "target": {
        "selector": ".line-tbl"
      }
    },
    {
      "key": "w3_expand_qc",
      "setup": [
        "openCreateDrawer()",
        "pickPo(POS.find(poSelectable).code)",
        "createWizard.step=3;renderCreateDrawer()",
        "createWizard.expandedLineId=createWizard.data.lines[0].id;renderCreateDrawer()"
      ],
      "wait": 700,
      "container": "#create-drawer",
      "target": {
        "selector": ".seg"
      }
    },
    {
      "key": "w3_summary",
      "setup": [
        "openCreateDrawer()",
        "pickPo(POS.find(poSelectable).code)",
        "createWizard.step=3;renderCreateDrawer()"
      ],
      "wait": 700,
      "container": "#create-drawer",
      "target": {
        "selector": "#line-summary-wrap"
      }
    },
    {
      "key": "w4_upload",
      "setup": [
        "openCreateDrawer()",
        "pickPo(POS.find(poSelectable).code)",
        "createWizard.step=4;renderCreateDrawer()"
      ],
      "wait": 700,
      "container": "#create-drawer",
      "target": {
        "selector": ".upload-zone"
      }
    },
    {
      "key": "w5_review",
      "setup": [
        "openCreateDrawer()",
        "pickPo(POS.find(poSelectable).code)",
        "createWizard.step=5;renderCreateDrawer()"
      ],
      "wait": 700,
      "container": "#create-drawer",
      "target": {
        "selector": ".card",
        "has_text": "ผลปลายทางเมื่อรับเข้า"
      }
    },
    {
      "key": "w_stepper",
      "setup": [
        "openCreateDrawer()",
        "pickPo(POS.find(poSelectable).code)",
        "createWizard.step=3;renderCreateDrawer()"
      ],
      "wait": 700,
      "container": "#create-drawer",
      "target": {
        "selector": ".stepper"
      }
    },
    {
      "key": "view_detail",
      "setup": [
        "openViewDrawer(GRNS.find(g=>g.status==='posted').id)"
      ],
      "wait": 700,
      "container": "#view-drawer",
      "target": {
        "selector": ".kv-grid"
      }
    },
    {
      "key": "view_tabs",
      "setup": [
        "openViewDrawer(GRNS.find(g=>g.status==='posted').id)"
      ],
      "wait": 700,
      "container": "#view-drawer",
      "target": {
        "selector": ".tabs"
      }
    },
    {
      "key": "view_reject_banner",
      "setup": [
        "openViewDrawer(GRNS.find(g=>g.lines.some(l=>l.qty_reject>0)).id)"
      ],
      "wait": 700,
      "container": "#view-drawer",
      "target": {
        "selector": ".note.warn"
      }
    },
    {
      "key": "view_qc",
      "setup": [
        "openViewDrawer(GRNS.find(g=>g.lines.some(l=>l.qty_reject>0)).id)",
        "viewState.tab='qc';renderViewDrawer()"
      ],
      "wait": 700,
      "container": "#view-drawer",
      "target": {
        "selector": ".drawer-body table"
      }
    },
    {
      "key": "view_pdf",
      "setup": [
        "openViewDrawer(GRNS.find(g=>g.status==='posted').id)",
        "viewState.tab='pdf';renderViewDrawer()"
      ],
      "wait": 700,
      "container": "#view-drawer",
      "target": {
        "selector": ".a4"
      }
    },
    {
      "key": "view_sign",
      "setup": [
        "openViewDrawer(GRNS.find(g=>g.status==='posted').id)",
        "viewState.tab='sign';renderViewDrawer()"
      ],
      "wait": 700,
      "container": "#view-drawer",
      "target": {
        "selector": ".sign-card"
      }
    },
    {
      "key": "view_history",
      "setup": [
        "openViewDrawer(GRNS.find(g=>g.status==='posted').id)",
        "viewState.tab='history';renderViewDrawer()"
      ],
      "wait": 700,
      "container": "#view-drawer",
      "target": {
        "selector": ".tl"
      }
    },
    {
      "key": "view_reversed",
      "setup": [
        "openViewDrawer(GRNS.find(g=>g.status==='reversed').id)"
      ],
      "wait": 700,
      "container": "#view-drawer",
      "target": {
        "selector": ".note.danger"
      }
    },
    {
      "key": "reason_modal",
      "setup": [
        "openReasonModal(GRNS.find(g=>g.status==='posted').id,'reverse')"
      ],
      "wait": 700,
      "container": ".overlay-wrap .modal",
      "target": {
        "selector": ".modal-body"
      }
    },
    {
      "key": "post_modal",
      "setup": [
        "openCreateDrawer()",
        "pickPo(POS.find(poSelectable).code)",
        "createWizard.step=5;renderCreateDrawer()",
        "openPostModal()"
      ],
      "wait": 800,
      "container": ".overlay-wrap .modal",
      "target": {
        "selector": ".modal-body"
      }
    }
  ]
}