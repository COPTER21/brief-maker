{
  "html": "01_HTML/F-PUR-PR.html",
  "route": "#/list",
  "vw": 1280, "vh": 1000,
  "device_scale": 2,
  "shots": [
    { "key": "list_table", "setup": [], "wait": 400, "container": "#page", "target": { "selector": "table.tbl" } },
    { "key": "list_filter", "setup": [], "wait": 350, "container": "#page", "target": { "selector": ".card", "has_text": "ทุกหน่วยงาน" } },
    { "key": "list_search", "setup": ["LIST.q='0007';render()"], "wait": 350, "container": "#page", "target": { "selector": "table.tbl" } },
    { "key": "list_filter_status", "setup": ["LIST.q='';LIST.status='approved';render()"], "wait": 350, "container": "#page", "target": { "selector": "table.tbl" } },
    { "key": "list_empty", "setup": ["LIST.status='';LIST.q='zzzzzz';render()"], "wait": 350, "container": "#page", "target": { "selector": ".state" } },
    { "key": "list_error", "setup": ["LIST.q='';LIST.error=true;render()"], "wait": 350, "container": "#page", "target": { "selector": ".state.err" } },
    { "key": "list_attach", "setup": ["LIST.error=false;render()"], "wait": 400, "container": "#page", "target": { "selector": ".card", "has_text": "เอกสารแนบล่าสุด" } },

    { "key": "wiz_step1", "setup": ["goCreate()"], "wait": 500, "container": ".drawer-panel", "target": { "selector": ".tile-row" } },
    { "key": "wiz_stepper", "setup": ["goCreate()"], "wait": 500, "container": ".drawer-panel", "target": { "selector": ".stepper" } },
    { "key": "wiz_step2", "setup": ["goCreate()", "createWizard.step=2;render()"], "wait": 450, "container": ".drawer-panel", "target": { "selector": ".form-grid" } },
    { "key": "wiz_step3", "setup": ["goCreate()", "createWizard.step=3;render()"], "wait": 450, "container": ".drawer-panel", "target": { "selector": "table.line-tbl" } },
    { "key": "wiz_summary", "setup": ["goCreate()", "createWizard.step=3;render()"], "wait": 450, "container": ".drawer-panel", "target": { "selector": "#line-summary-wrap" } },
    { "key": "wiz_step4", "setup": ["goCreate()", "createWizard.step=4;render()"], "wait": 450, "container": ".drawer-panel", "target": { "selector": ".upload-zone" } },
    { "key": "wiz_step5", "setup": ["goCreate()", "createWizard.step=5;render()"], "wait": 450, "container": ".drawer-panel", "target": { "selector": ".card", "has_text": "สายอนุมัติ" } },
    { "key": "submit_modal", "setup": ["goCreate()", "createWizard.step=5;render()", "openSubmitModal()"], "wait": 500, "container": ".modal", "target": { "selector": ".modal-b" } },

    { "key": "view_tabs", "setup": ["goView('pr2')"], "wait": 500, "container": ".drawer-panel", "target": { "selector": ".tabs" } },
    { "key": "view_detail", "setup": ["goView('pr2')"], "wait": 500, "container": ".drawer-panel", "target": { "selector": ".sec", "has_text": "ข้อมูลเอกสาร" } },
    { "key": "view_lines", "setup": ["goView('pr2')"], "wait": 500, "container": ".drawer-panel", "target": { "selector": ".sec", "has_text": "รายการที่ขอซื้อ" } },
    { "key": "view_attach", "setup": ["goView('pr2')"], "wait": 500, "container": ".drawer-panel", "target": { "selector": ".sec", "has_text": "เอกสารแนบ" } },
    { "key": "forward_box", "setup": ["goView('pr2')"], "wait": 500, "container": ".drawer-panel", "target": { "selector": ".sec", "has_text": "การส่งต่อเอกสาร" } },
    { "key": "view_pdf", "setup": ["goView('pr2')", "setTab('pdf')"], "wait": 600, "container": ".drawer-panel", "target": { "selector": ".a4" } },
    { "key": "view_sign", "setup": ["goView('pr1')", "setTab('sign')"], "wait": 600, "container": ".drawer-panel", "target": { "selector": ".sec" } },
    { "key": "view_history", "setup": ["goView('pr1')", "setTab('history')"], "wait": 600, "container": ".drawer-panel", "target": { "selector": ".tl" } },
    { "key": "view_actions", "setup": ["goView('pr1')"], "wait": 500, "container": ".drawer-panel", "target": { "selector": ".dw-actions" } },
    { "key": "reason_modal", "setup": ["goView('pr1')", "openReasonModal('pr1','reject')"], "wait": 550, "container": ".modal", "target": { "selector": ".modal-b" } },
    { "key": "view_rejected", "setup": ["goView('pr4')", "setTab('sign')"], "wait": 550, "container": ".drawer-panel", "target": { "selector": ".sec" } }
  ]
}
