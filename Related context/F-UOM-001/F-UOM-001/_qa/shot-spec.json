{
  "html": "uom-master.html",
  "route": "#/uom",
  "vw": 1440, "vh": 950, "device_scale": 2,
  "shots": [
    { "key": "list_header",  "setup": [], "wait": 400, "container": "#page-content", "target": { "selector": ".ph" } },
    { "key": "list_stats",   "setup": [], "wait": 400, "container": "#page-content", "target": { "selector": ".stats" } },
    { "key": "list_filter",  "setup": [], "wait": 400, "container": ".list-card",    "target": { "selector": ".filter-bar" } },
    { "key": "list_table",   "setup": [], "wait": 400, "container": ".list-card",    "target": { "selector": ".table-wrap" } },
    { "key": "list_footer",  "setup": [], "wait": 400, "container": ".list-card",    "target": { "selector": ".table-foot" } },
    { "key": "list_sorted",  "setup": ["sortBy('used')"], "wait": 400, "container": ".list-card", "target": { "selector": ".table-wrap" } },
    { "key": "list_filtered","setup": ["applyFilter('status','draft')"], "wait": 400, "container": ".list-card", "target": { "selector": ".table-wrap" } },
    { "key": "list_empty",   "setup": ["applyFilter('search','ไม่มีทางเจอแน่นอน')"], "wait": 400, "container": ".list-card", "target": { "selector": ".empty" } },
    { "key": "list_page2",   "setup": ["goToPage(2)"], "wait": 400, "container": ".list-card", "target": { "selector": ".table-foot" } },
    { "key": "bulk_bar",     "setup": ["state.sel={}; RAW.slice(0,2).forEach(r=>state.sel[r.id]=true); render();"], "wait": 400, "container": ".list-card", "target": { "selector": ".bulk-bar" } },
    { "key": "form_create",  "setup": ["openCreate()"], "wait": 600, "container": "#drawer", "target": { "selector": ".form-grid" } },
    { "key": "form_footer",  "setup": ["openCreate()"], "wait": 600, "container": "#drawer", "target": { "selector": ".drawer-footer" } },
    { "key": "form_error",   "setup": ["openCreate()", "setTimeout(()=>document.getElementById('btn-save').click(),350)"], "wait": 900, "container": "#drawer", "target": { "selector": "#fld-name" } },
    { "key": "view_header",  "setup": ["openView(RAW.find(r=>r.code==='BOX').id)"], "wait": 600, "container": "#drawer", "target": { "selector": ".dw-head-row" } },
    { "key": "view_overview","setup": ["openView(RAW.find(r=>r.code==='BOX').id)"], "wait": 600, "container": "#drawer", "target": { "selector": ".drawer-body" } },
    { "key": "view_usage",   "setup": ["openView(RAW.find(r=>r.code==='PCS').id)", "setTimeout(()=>switchTab('usage'),350)"], "wait": 900, "container": "#drawer", "target": { "selector": ".drawer-body" } },
    { "key": "view_history", "setup": ["openView(RAW.find(r=>r.code==='BOX').id)", "setTimeout(()=>switchTab('history'),350)"], "wait": 900, "container": "#drawer", "target": { "selector": ".drawer-body" } },
    { "key": "status_menu",  "setup": ["openView(RAW.find(r=>r.code==='BOX').id)", "setTimeout(()=>toggleStatusMenu(document.getElementById('btnStatus')),400)"], "wait": 1000, "container": "#drawer", "target": { "selector": ".dw-head-row" } },
    { "key": "modal_delete", "setup": ["state.sel={}; state.sel[RAW.find(r=>r.code==='PCS').id]=true; state.sel[RAW.find(r=>r.code==='PACK').id]=true; render(); setTimeout(()=>openBulkDelete(),350)"], "wait": 900, "container": "#modalBackdrop", "target": { "selector": ".modal" } },
    { "key": "import_pick",  "setup": ["openImport()"], "wait": 600, "container": "#modalBackdrop", "target": { "selector": ".modal" } },
    { "key": "import_prev",  "setup": ["openImport()", "setTimeout(()=>impPick(),350)"], "wait": 900, "container": "#modalBackdrop", "target": { "selector": ".imp-wrap" } },
    { "key": "import_done",  "setup": ["openImport()", "setTimeout(()=>impPick(),300)", "setTimeout(()=>impConfirm(),600)"], "wait": 1200, "container": "#modalBackdrop", "target": { "selector": ".modal" } }
  ]
}
