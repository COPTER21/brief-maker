{
  "html": "Promotion.html",
  "route": "#/promotions",
  "vw": 1440,
  "vh": 1000,
  "device_scale": 1,
  "shots": [
    {"key":"list_main","setup":["render()"],"wait":250,"container":"#page-content","target":{"selector":"#page-content"}},
    {"key":"list_filters","setup":["render()"],"wait":250,"container":"#page-content","target":{"selector":".filter-bar"}},
    {"key":"create_step1","setup":["openCreate()"],"wait":250,"container":"#drawerEl","target":{"selector":"#drawerEl"}},
    {"key":"create_step2","setup":["openCreate()","state.drawer.step=2; renderDrawerOnly()"],"wait":250,"container":"#drawerEl","target":{"selector":"#drawerEl"}},
    {"key":"create_step3","setup":["openCreate()","state.drawer.step=3; renderDrawerOnly()"],"wait":250,"container":"#drawerEl","target":{"selector":"#drawerEl"}},
    {"key":"view_rule","setup":["openView(PROMOS[0].id)"],"wait":250,"container":"#drawerEl","target":{"selector":"#drawerEl"}},
    {"key":"view_approval","setup":["openView(PROMOS.find(p => p.status === 'pending_approval').id)","setTab('approval')"],"wait":250,"container":"#drawerEl","target":{"selector":"#drawerEl"}},
    {"key":"view_history","setup":["openView(PROMOS[0].id)","setTab('history')"],"wait":250,"container":"#drawerEl","target":{"selector":"#drawerEl"}},
    {"key":"sim_cart","setup":["openSim()"],"wait":250,"container":"#drawerEl","target":{"selector":"#drawerEl"}},
    {"key":"sim_results","setup":["openSim()"],"wait":250,"container":"#drawerEl","target":{"selector":".drawer-section","has_text":"โปรโมชันที่ประเมิน"}},
    {"key":"submit_modal","setup":["openModal('submit', PROMOS.find(p => p.status === 'draft').id)"],"wait":250,"container":"#modalCard","target":{"selector":"#modalCard"}},
    {"key":"action_modal","setup":["openModal('pause', PROMOS[0].id)"],"wait":250,"container":"#modalCard","target":{"selector":"#modalCard"}}
  ]
}
