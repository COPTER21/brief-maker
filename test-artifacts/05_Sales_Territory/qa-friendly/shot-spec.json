{
  "html": "sales-territory.html",
  "route": "#/sales-territory",
  "vw": 1200,
  "vh": 900,
  "device_scale": 2,
  "shots": [
    {"key":"home_tabs","setup":[],"container":"#page-content","target":{"selector":".drawer-tabs"}},
    {"key":"home_kpis","setup":[],"container":"#page-content","target":{"selector":".stats"}},
    {"key":"structure_search","setup":["setQ('R-BK')"],"container":"#page-content","target":{"selector":"#qInput"}},
    {"key":"structure_filters","setup":[],"container":"#page-content","target":{"selector":".filter-bar"}},
    {"key":"structure_table","setup":[],"container":"#page-content","target":{"selector":".table-wrap"}},
    {"key":"empty_state","setup":["setQ('ZZZ-NOT-FOUND')"],"container":"#page-content","target":{"selector":".empty"}},
    {"key":"archived_list","setup":["setStatus('archived')"],"container":"#page-content","target":{"selector":".table-wrap"}},
    {"key":"central_region","setup":[],"container":"#page-content","target":{"selector":".region-row","has_text":"ภาคกลาง"}},

    {"key":"create_form","setup":["openCreate()"],"container":"#drawerEl","target":{"selector":".drawer-body"}},
    {"key":"create_identity","setup":["openCreate()"],"container":"#drawerEl","target":{"selector":"#fld-code"}},
    {"key":"create_footer","setup":["openCreate()"],"container":"#drawerEl","target":{"selector":".drawer-footer"}},
    {"key":"province_combo","setup":["openCreate()","cbFocus('prov')"],"container":"body","target":{"selector":".cb-menu"}},
    {"key":"rep_combo","setup":["openCreate()","cbFocus('rep')"],"container":"body","target":{"selector":".cb-menu"}},
    {"key":"create_code_error","setup":["openCreate()","state.form.code='R';state.form.name='ทดสอบ';state.form.rep='เอก ทวีสุข';save()"],"container":"#drawerEl","target":{"selector":"#fld-code"}},
    {"key":"rep_error","setup":["openCreate()","state.form.code='R-TC-99';state.form.name='ทดสอบ';state.form.rep='';save()"],"container":"#drawerEl","target":{"selector":"#fld-rep"}},
    {"key":"type_select","setup":["openCreate()"],"container":"#drawerEl","target":{"selector":".field select","has_text":"Area Route (GT)"}},
    {"key":"region_select","setup":["openCreate()"],"container":"#drawerEl","target":{"selector":".field select","has_text":"ภาคกลาง"}},

    {"key":"view_header","setup":["openView('R-BK-01')"],"container":"#drawerEl","target":{"selector":".drawer-header"}},
    {"key":"view_info","setup":["openView('R-BK-01')"],"container":"#drawerEl","target":{"selector":".drawer-section","has_text":"ข้อมูล Route"}},
    {"key":"view_footer","setup":["openView('R-BK-01')"],"container":"#drawerEl","target":{"selector":".drawer-footer"}},
    {"key":"future_hooks","setup":["openView('R-BK-01')"],"container":"#drawerEl","target":{"selector":".related-actions"}},

    {"key":"edit_form","setup":["openEdit('R-BK-01')"],"container":"#drawerEl","target":{"selector":".form-grid"}},
    {"key":"edit_code_locked","setup":["openEdit('R-BK-01')"],"container":"#drawerEl","target":{"selector":"#fld-code"}},
    {"key":"edit_footer","setup":["openEdit('R-BK-01')"],"container":"#drawerEl","target":{"selector":".drawer-footer"}},
    {"key":"edit_name_error","setup":["openEdit('R-BK-01')","state.form.name=' ';save()"],"container":"#drawerEl","target":{"selector":"#fld-name"}},

    {"key":"archive_modal","setup":["openArchive('R-BK-01')"],"container":"#modalCard","target":{"selector":".modal-body"}},
    {"key":"workload_tab","setup":["setTab('workload')"],"container":"#page-content","target":{"selector":".table-foot","has_text":"งาน/เดือน"}},
    {"key":"map_overview","setup":["setTab('map')"],"container":"#page-content","target":{"selector":".map-wrap"}},
    {"key":"map_hover","setup":["setTab('map')","state.mapHover='กรุงเทพมหานคร';render()"],"container":"#page-content","target":{"selector":".map-right","has_text":"กรุงเทพมหานคร"}},
    {"key":"map_selected","setup":["setTab('map')","mapSelect('กรุงเทพมหานคร')"],"container":"#page-content","target":{"selector":".map-right","has_text":"ยกเลิกการเลือก"}},
    {"key":"map_panel","setup":["setTab('map')","mapSelect('กรุงเทพมหานคร')"],"container":"#page-content","target":{"selector":".map-right"}}
  ]
}
