{
  "html": "expense.html",
  "vw": 1300,
  "vh": 950,
  "device_scale": 2,
  "shots": [
    { "key": "list_self",  "setup": ["setRole('admin')"], "container": "#page-content", "target": { "selector": ".tbl" } },
    { "key": "list_all",   "setup": ["setRole('officer')"], "container": "#page-content", "target": { "selector": ".tbl" } },
    { "key": "list_empty", "setup": ["setRole('mgr')","state.filters.search='zzzไม่มีจริง';render()"], "container": "#page-content", "target": { "selector": ".empty" } },

    { "key": "wiz_src",     "setup": ["openCreate()"], "wait": 350, "container": "#drawer", "target": { "selector": ".chips" } },
    { "key": "wiz_stepper", "setup": ["openCreate()"], "wait": 350, "container": "#drawer", "target": { "selector": ".stepper" } },
    { "key": "wiz_main",    "setup": ["openCreate()","state.wizard.step=2;state.wizard.doc.emp='E03';renderDrawerOnly()"], "wait": 350, "container": "#drawer", "target": { "selector": ".hookbox" } },
    { "key": "wiz_pay",     "setup": ["openCreate()","state.wizard.step=2;state.wizard.doc.emp='E01';renderDrawerOnly()"], "wait": 350, "container": "#drawer", "target": { "selector": ".field", "has_text": "ช่องทางจ่าย" } },
    { "key": "wiz_lines",   "setup": ["openCreate()","state.wizard.doc.emp='E01';state.wizard.doc.lines=[{date:'2569-08-31',cat:'mat',desc:'กระดาษ',qty:1,unit_price:1000,vat_mode:'none'},{date:'2569-08-31',cat:'mat',desc:'หมึก',qty:1,unit_price:1000,vat_mode:'add'},{date:'2569-08-31',cat:'mat',desc:'ปากกา',qty:1,unit_price:1070,vat_mode:'included'}];state.wizard.step=3;renderDrawerOnly()"], "wait": 350, "container": "#drawer", "target": { "selector": ".line-tbl" } },
    { "key": "wiz_overcap", "setup": ["openCreate()","state.wizard.doc.emp='E01';state.wizard.doc.lines=[{date:'2569-08-31',cat:'travel',desc:'เหมารถตู้ต่างจังหวัด',qty:1,unit_price:8000,vat_mode:'add'}];state.wizard.step=3;renderDrawerOnly()"], "wait": 350, "container": "#drawer", "target": { "selector": ".line-tbl" } },
    { "key": "wiz_attach",  "setup": ["openCreate()","state.wizard.doc.emp='E01';state.wizard.doc.lines=[{date:'2569-08-31',cat:'lodge',desc:'โรงแรม 1 คืน',qty:1,unit_price:1800,vat_mode:'add'}];state.wizard.step=4;renderDrawerOnly()"], "wait": 350, "container": "#drawer", "target": { "selector": ".upload-zone" } },
    { "key": "wiz_review",  "setup": ["openCreate()","state.wizard.doc.emp='E01';state.wizard.doc.lines=[{date:'2569-08-31',cat:'mat',desc:'จัดซื้ออุปกรณ์',qty:1,unit_price:8000,vat_mode:'add'}];state.wizard.step=5;renderDrawerOnly()"], "wait": 350, "container": "#drawer", "target": { "selector": ".sec", "has_text": "สายอนุมัติ" } },
    { "key": "wiz_welfare", "setup": ["openCreate()","state.wizard.doc.emp='E01';state.wizard.doc.lines=[{date:'2569-08-31',cat:'ent',desc:'เลี้ยงรับรอง',qty:1,unit_price:6000,vat_mode:'add'}];state.wizard.step=5;renderDrawerOnly()"], "wait": 350, "container": "#drawer", "target": { "selector": ".hookbox", "has_text": "สวัสดิการ" } },

    { "key": "submit_2slot", "setup": ["state.doaDraft={picks:{},grand:8000};openModal('submit',{})"], "wait": 450, "container": ".modal", "target": { "selector": ".mnote" } },
    { "key": "submit_1slot", "setup": ["state.doaDraft={picks:{},grand:1000};openModal('submit',{})"], "wait": 450, "container": ".modal", "target": { "selector": ".mnote" } },
    { "key": "submit_3slot", "setup": ["state.doaDraft={picks:{},grand:60000};openModal('submit',{})"], "wait": 450, "container": ".modal", "target": { "selector": ".slot-row" } },

    { "key": "view_detail",  "setup": ["setRole('mgr')","openView('d2')"], "wait": 400, "container": "#drawer", "target": { "selector": ".kv" } },
    { "key": "view_pay",     "setup": ["setRole('mgr')","openView('d2')"], "wait": 400, "container": "#drawer", "target": { "selector": ".sec", "has_text": "สถานะการจ่าย" } },
    { "key": "view_advance", "setup": ["setRole('mgr')","openView('d4')"], "wait": 400, "container": "#drawer", "target": { "selector": ".sec", "has_text": "เคลียร์เงินทดรอง" } },
    { "key": "view_pdf",     "setup": ["setRole('mgr')","openView('d2')","setVtab('pdf')"], "wait": 400, "container": "#drawer", "target": { "selector": ".a4" } },
    { "key": "view_sign",    "setup": ["setRole('mgr')","openView('d4')","setVtab('sign')"], "wait": 400, "container": "#drawer", "target": { "selector": ".sec", "has_text": "สายอนุมัติ" } },
    { "key": "view_history", "setup": ["setRole('mgr')","openView('d2')","setVtab('history')"], "wait": 400, "container": "#drawer", "target": { "selector": ".sec", "has_text": "ประวัติ" } },

    { "key": "approve_modal", "setup": ["setRole('mgr')","openModal('approve',{id:'d3'})"], "wait": 450, "container": ".modal", "target": { "selector": ".mdesc" } },
    { "key": "reject_modal",  "setup": ["setRole('mgr')","openModal('reject',{id:'d3'})"], "wait": 450, "container": ".modal", "target": { "selector": ".modal-body" } },
    { "key": "cancel_modal",  "setup": ["setRole('admin')","openModal('cancel',{id:'d1'})"], "wait": 450, "container": ".modal", "target": { "selector": ".mdesc" } }
  ]
}
