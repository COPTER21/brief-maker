{
 "html": "อบรม.html",
 "route": "#/train/course",
 "vw": 1300,
 "vh": 950,
 "device_scale": 2,
 "shots": [
  { "key": "course_list", "setup": ["go('train/course')","render()"], "container": "#page-content", "target": { "selector": ".table" } },
  { "key": "course_filter", "setup": ["go('train/course')","render()"], "container": "#page-content", "target": { "selector": ".filter-bar" } },
  { "key": "course_empty", "setup": ["go('train/course')","TC.f.course.q='zzzไม่มีจริง'","renderPageOnly()"], "container": "#page-content", "target": { "selector": ".empty" } },
  { "key": "plan_list", "setup": ["go('train/plan')","render()"], "container": "#page-content", "target": { "selector": ".table" } },
  { "key": "plan_empty", "setup": ["go('train/plan')","TC.f.plan.q='zzzไม่มีจริง'","renderPageOnly()"], "container": "#page-content", "target": { "selector": ".empty" } },
  { "key": "result_list", "setup": ["go('train/result')","render()"], "container": "#page-content", "target": { "selector": ".table" } },
  { "key": "result_empty", "setup": ["go('train/result')","TC.f.result.q='zzzไม่มี'","renderPageOnly()"], "container": "#page-content", "target": { "selector": ".empty" } },
  { "key": "report_stats", "setup": ["go('train/report')","render()"], "container": "#page-content", "target": { "selector": ".stats" } },
  { "key": "report_funnel", "setup": ["go('train/report')","render()"], "container": "#page-content", "target": { "selector": ".funnel" } },
  { "key": "report_costhead", "setup": ["go('train/report')","render()"], "container": "#page-content", "target": { "selector": ".cph-grid" } },

  { "key": "course_form", "setup": ["openCourseCreate()"], "wait": 350, "container": "#drawer", "target": { "selector": ".form-section", "has_text": "ข้อมูลหลักสูตร" } },
  { "key": "course_cost", "setup": ["openCourseCreate()","TC.draft.has_cost=true","render()"], "wait": 350, "container": "#drawer", "target": { "selector": ".form-section", "has_text": "ค่าใช้จ่าย" } },
  { "key": "course_view", "setup": ["openCourseView('CO4')"], "wait": 350, "container": "#drawer", "target": { "selector": ".drawer-header" } },
  { "key": "course_history", "setup": ["openCourseView('CO1')"], "wait": 350, "container": "#drawer", "target": { "selector": ".secwrap", "has_text": "ประวัติ" } },

  { "key": "session_form", "setup": ["openSessionCreate()"], "wait": 350, "container": "#drawer", "target": { "selector": ".form-section", "has_text": "หลักสูตร" } },
  { "key": "session_view", "setup": ["openSessionView('SE1','detail')"], "wait": 350, "container": "#drawer", "target": { "selector": ".secwrap", "has_text": "รายละเอียดรอบอบรม" } },
  { "key": "learner_open", "setup": ["openSessionView('SE1','learner')"], "wait": 350, "container": "#drawer", "target": { "selector": ".btn", "has_text": "ลงทะเบียนผู้เรียน" } },
  { "key": "learner_full", "setup": ["getSession('SE1').capacity=2","openSessionView('SE1','learner')"], "wait": 350, "container": "#drawer", "target": { "selector": ".note", "has_text": "จำนวนรับเต็มแล้ว" } },
  { "key": "learner_closed", "setup": ["openSessionView('SE2','learner')"], "wait": 350, "container": "#drawer", "target": { "selector": ".att-toggle" } },
  { "key": "session_approval_paid", "setup": ["openSessionView('SE1','approval')"], "wait": 350, "container": "#drawer", "target": { "selector": ".ec-ref" } },
  { "key": "session_approval_free", "setup": ["openSessionView('SE2','approval')"], "wait": 350, "container": "#drawer", "target": { "selector": ".note", "has_text": "ไม่มีค่าใช้จ่าย" } },
  { "key": "session_history", "setup": ["openSessionView('SE1','history')"], "wait": 350, "container": "#drawer", "target": { "selector": ".secwrap", "has_text": "ประวัติ" } },

  { "key": "enroll_paid", "setup": ["openEnrollModal('SE1')"], "wait": 450, "container": ".modal", "target": { "selector": ".note", "has_text": "มีค่าใช้จ่าย" } },
  { "key": "enroll_free", "setup": ["getSession('SE1').courseId='CO3'","openEnrollModal('SE1')"], "wait": 450, "container": ".modal", "target": { "selector": ".note", "has_text": "ไม่มีค่าใช้จ่าย" } },
  { "key": "enroll_gap", "setup": ["openEnrollModal('SE1')"], "wait": 450, "container": ".modal", "target": { "selector": ".secwrap", "has_text": "แนะนำจากผลประเมิน" } },
  { "key": "doa_modal", "setup": ["openDoaModal('EN1')"], "wait": 450, "container": ".modal", "target": { "selector": ".slot" } },
  { "key": "result_modal", "setup": ["getEnroll('EN5').attended=true","openResultModal('EN5')"], "wait": 450, "container": ".modal", "target": { "selector": ".rf-pick" } },
  { "key": "result_eval", "setup": ["getEnroll('EN5').attended=true","openResultModal('EN5')"], "wait": 450, "container": ".modal", "target": { "selector": ".ev-pick" } },
  { "key": "emphist_modal", "setup": ["openEmpHistory('EMP-04')"], "wait": 450, "container": ".modal", "target": { "selector": ".eh-summary" } },
  { "key": "confirm_course_close", "setup": ["courseClose('CO4')"], "wait": 450, "container": ".modal", "target": { "selector": ".modal-title", "has_text": "ปิดหลักสูตร" } },
  { "key": "confirm_session_close", "setup": ["sessionClose('SE1')"], "wait": 450, "container": ".modal", "target": { "selector": ".modal-title", "has_text": "ปิดรอบ" } },
  { "key": "confirm_cancel", "setup": ["cancelEnroll('EN2')"], "wait": 450, "container": ".modal", "target": { "selector": ".modal-title", "has_text": "ยกเลิกการลงทะเบียน" } },
  { "key": "confirm_cert", "setup": ["getEnroll('EN3').cert=null","issueCert('EN3')"], "wait": 450, "container": ".modal", "target": { "selector": ".modal-title", "has_text": "ออกใบรับรอง" } },
  { "key": "reason_modal", "setup": ["openReasonModal({title:'ไม่อนุมัติการลงทะเบียน',label:'เหตุผลที่ไม่อนุมัติ',confirmLabel:'ไม่อนุมัติ',danger:true})"], "wait": 450, "container": ".modal", "target": { "selector": ".notes-area" } }
 ]
}
