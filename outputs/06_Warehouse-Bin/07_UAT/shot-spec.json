{
  "html":"../warehouse-bin.html","vw":1360,"vh":900,"device_scale":1,
  "shots":[
    {"key":"shell","setup":[],"container":"body","target":{"selector":".sidebar"}},
    {"key":"list_stats","setup":[],"container":"#page-content","target":{"selector":".stats"}},
    {"key":"list_path","setup":["selectNode('rack','R-A01')"],"container":"#page-content","target":{"selector":".drill-path"}},
    {"key":"all_locations","setup":["selectNode('all-locations',null)"],"container":"#page-content","target":{"selector":".card-head","has_text":"Location ทั้งหมด"}},
    {"key":"list_filter","setup":["selectNode('all-locations',null)"],"container":"#page-content","target":{"selector":".filter-bar"}},
    {"key":"list_empty","setup":["selectNode('all-locations',null)","setFilter('search','ไม่พบ-999')"],"container":"#page-content","target":{"selector":".empty"}},
    {"key":"hierarchy","setup":["setView('hierarchy')","selectNode('zone','Z-STORAGE')"],"container":"#page-content","target":{"selector":".explorer"}},
    {"key":"warehouse_form","setup":["openDrawer('create','warehouse',null)"],"container":"#drawer","target":{"selector":".drawer-section","has_text":"ข้อมูลคลัง"}},
    {"key":"branch_picker","setup":["openDrawer('create','warehouse',null)","onBranchFocus()"],"container":"body","target":{"selector":"#branch-portal"}},
    {"key":"warehouse_geo","setup":["openDrawer('create','warehouse',null)"],"container":"#drawer","target":{"selector":".drawer-section","has_text":"ที่อยู่"}},
    {"key":"form_footer","setup":["openDrawer('create','warehouse',null)"],"container":"#drawer","target":{"selector":".drawer-footer"}},
    {"key":"zone_temp","setup":["selectNode('warehouse','WH-01')","openDrawer('create','zone',null)","state.form.temp_controlled=true;render()"],"container":"#drawer","target":{"selector":".drawer-section","has_text":"การควบคุมอุณหภูมิ"}},
    {"key":"location_step1","setup":["selectNode('rack','R-A01')","openDrawer('create','location',null)"],"container":"#drawer","target":{"selector":".drawer-section","has_text":"Parent (flexible)"}},
    {"key":"location_step2","setup":["selectNode('rack','R-A01')","openDrawer('create','location',null)","state.form.code='UAT-R1-C1-L1';state.drawer.step=2;render()"],"container":"#drawer","target":{"selector":".drawer-section","has_text":"ความจุ & การหมุนเวียน"}},
    {"key":"location_direct_error","setup":["openDrawer('create','location',null)","state.form.parent_type='area';state.form.area_id='A-AISLE-A';state.form.code='BAD-DIRECT';render()"],"container":"#drawer","target":{"selector":".field-error"}},
    {"key":"location_uom_lock","setup":["openDrawer('edit','location','L001')","state.drawer.step=2;render()"],"container":"#drawer","target":{"selector":".field-error","has_text":"เปลี่ยนหน่วยเก็บไม่ได้"}},
    {"key":"status_modal","setup":["state.modal={open:true,id:'L002',level:'status-reason',target:'blocked'};render()"],"container":"#modalEl","target":{"selector":"#sr-reason"}},
    {"key":"decommission_blocked","setup":["openModal('location','L001')"],"container":"#modalEl","target":{"selector":".warn-box"}},
    {"key":"decommission_confirm","setup":["openModal('location','L002')"],"container":"#modalEl","target":{"selector":".modal-footer"}},
    {"key":"delete_blocked","setup":["openModal('warehouse','WH-01')"],"container":"#modalEl","target":{"selector":".warn-box"}},
    {"key":"quick_add","setup":["selectNode('rack','R-A01')"],"container":"#page-content","target":{"selector":".qa-row"}},
    {"key":"bulk_bar","setup":["selectNode('all-locations',null)","state.bulkSel.add('L001');state.bulkSel.add('L002');render()"],"container":"#page-content","target":{"selector":".bulk-bar"}},
    {"key":"bulk_generate","setup":["selectNode('area','A-AISLE-A')","openDrawer('bulk',null,null)"],"container":"#drawer","target":{"selector":".preview-box"}}
  ]
}
