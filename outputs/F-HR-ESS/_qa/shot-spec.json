  { "key": "notify_feed",
    "setup": ["goTab('notify')"],
    "container": "#appContent",
    "target": { "selector": ".ess-sec-head", "has_text": "แจ้งเตือนของฉัน" } },

  { "key": "notify_search",
    "setup": ["goTab('notify')", "state.notif.q='สลิป'; render();"],
    "container": "#appContent",
    "target": { "selector": ".nfeed" } },

  { "key": "notify_empty",
    "setup": ["goTab('notify')", "state.notif.q='zzzไม่มีจริง'; render();"],
    "container": "#appContent",
    "target": { "selector": ".empty", "has_text": "ไม่พบการแจ้งเตือน" } },

  { "key": "notify_filter",
    "setup": ["goTab('notify')", "state.notif.unread=true; render();"],
