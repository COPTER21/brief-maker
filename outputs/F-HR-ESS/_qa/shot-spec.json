{
 "html": "ess.html",
 "vw": 1300, "vh": 1000, "device_scale": 2,
 "shots": [
  { "key": "home_top",
    "setup": ["goTab('home')"],
    "container": "#appContent",
    "target": { "selector": ".ess-tabs", "has_text": "หน้าหลัก" } },

  { "key": "home_banner",
    "setup": ["goTab('home')"],
    "container": "#appContent",
    "target": { "selector": ".self-banner" } },

  { "key": "home_launcher",
    "setup": ["goTab('home')"],
