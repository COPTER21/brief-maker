{
  "html": "F-WH-STKADJ.html",
  "route": "#/list",
  "vw": 1280,
  "vh": 900,
  "device_scale": 2,
  "shots": [
    { "key": "list",
      "setup": [],
      "wait": 400,
      "container": "#ss-page",
      "target": { "selector": ".kpi-row" } },

    { "key": "wizard_s1",
      "setup": ["openCreateDrawer(null)"],
      "wait": 500,
      "container": "#ss-create-drawer",
      "target": { "selector": ".stepper" } },

    { "key": "wizard_s2",
      "setup": ["openCreateDrawer(null)", "createWizard.step=2;renderCreateDrawer()"],
      "wait": 500,
      "container": "#ss-create-drawer",
      "target": { "selector": ".stepper" } },

    { "key": "wizard_s3",
      "setup": ["openCreateDrawer(null)", "createWizard.step=3;renderCreateDrawer()"],
      "wait": 500,
      "container": "#ss-create-drawer",
      "target": { "selector": ".stepper" } },

    { "key": "wizard_s4",
      "setup": ["openCreateDrawer(null)", "createWizard.step=4;renderCreateDrawer()"],
      "wait": 500,
      "container": "#ss-create-drawer",
      "target": { "selector": ".stepper" } },

    { "key": "wizard_s5",
      "setup": ["openCreateDrawer(null)", "createWizard.step=5;renderCreateDrawer()"],
      "wait": 500,
      "container": "#ss-create-drawer",
      "target": { "selector": ".stepper" } },

    { "key": "view_detail",
      "setup": ["openViewDrawer('d1')"],
      "wait": 500,
      "container": "#ss-view-drawer",
      "target": { "selector": ".tabs" } },

    { "key": "view_actions",
      "setup": ["openViewDrawer('d3')"],
      "wait": 500,
      "container": "#ss-view-drawer",
      "target": { "selector": "button", "has_text": "อนุมัติ" } },

    { "key": "view_pdf",
      "setup": ["openViewDrawer('d1')", "viewState.tab='pdf';renderViewDrawer()"],
      "wait": 500,
      "container": "#ss-view-drawer",
      "target": { "selector": ".a4" } },

    { "key": "view_sign",
      "setup": ["openViewDrawer('d3')", "viewState.tab='sign';renderViewDrawer()"],
      "wait": 500,
      "container": "#ss-view-drawer",
      "target": { "selector": ".tabs" } },

    { "key": "view_history",
      "setup": ["openViewDrawer('d1')", "viewState.tab='history';renderViewDrawer()"],
      "wait": 500,
      "container": "#ss-view-drawer",
      "target": { "selector": ".tabs" } }
  ]
}
