{
  "html": "performance.html",
  "vw": 1280,
  "vh": 900,
  "device_scale": 2,
  "shots": [
    { "key": "cycle_list",
      "setup": [],
      "container": "#page-content",
      "target": { "selector": "button.btn-primary", "has_text": "สร้างรอบประเมิน" } },

    { "key": "new_cycle_drawer",
      "setup": ["openDrawer('newCycle')"],
      "container": "#drawer",
      "target": { "selector": ".note.is-warn", "has_text": "อ่านจาก ตั้งค่า HR" } },

    { "key": "cycle_close_btn",
      "setup": ["openDrawer('viewCycle','CY1')"],
      "container": "#drawer",
      "target": { "selector": ".btn-danger", "has_text": "ปิดรอบ" } },

    { "key": "close_cycle_modal",
      "setup": ["openModal('closeCycle',{id:'CY1'})"],
      "container": "#modalBackdrop .modal",
      "target": { "selector": ".modal-title", "has_text": "ปิดรอบประเมิน" } },

    { "key": "appr_list",
      "setup": ["state.tab='appr';render()"],
      "container": "#view",
      "target": { "selector": ".table-wrap" } },

    { "key": "kpi_editor",
      "setup": ["openAppr('A1')", "state.view.tab='kpi';render()"],
      "container": "#drawer",
      "target": { "selector": "#wsumTag", "has_text": "น้ำหนักรวม" } },

    { "key": "kpi_closed_banner",
      "setup": ["cyc('CY1').status='closed'", "openAppr('A1')", "state.view.tab='kpi';render()"],
      "container": "#drawer",
      "target": { "selector": ".note.is-warn", "has_text": "รอบนี้ปิดแล้ว" } },

    { "key": "self_score",
      "setup": ["setRole('staff')", "openAppr('A2')", "state.view.tab='kpi';render()"],
      "container": "#drawer",
      "target": { "selector": "#btnSelf", "has_text": "บันทึกประเมินตนเอง" } },

    { "key": "mgr_score",
      "setup": ["openAppr('A3')", "state.view.tab='kpi';render()"],
      "container": "#drawer",
      "target": { "selector": "#btnMgr", "has_text": "บันทึกผลหัวหน้า" } },

    { "key": "mgr_weighted",
      "setup": ["openAppr('A4')", "state.view.tab='kpi';render()"],
      "container": "#drawer",
      "target": { "selector": ".totbox", "has_text": "คะแนนรวมถ่วงน้ำหนัก" } },

    { "key": "review_queue",
      "setup": ["state.tab='review';render()"],
      "container": "#view",
      "target": { "selector": "button.btn-primary", "has_text": "สอบทาน (DOA)" } },

    { "key": "doa_pick",
      "setup": ["state.tab='review';render()", "openModal('doaCalib',{id:'A4'})"],
      "container": "#modalBackdrop .modal",
      "target": { "selector": ".note.is-warn", "has_text": "เลือกครบทั้ง 2 ขั้น" } },

    { "key": "doa_stage1",
      "setup": ["state.tab='review';render()", "appr('A4').approvals=[{no:1,role:'หัวหน้าสายงาน',personId:'x1',personName:'ประสงค์ ชัยมงคล',status:'current',at:null,actor:null},{no:2,role:'ผู้สอบทาน (HRBP/ผู้บริหาร)',personId:'x2',personName:'วิชัย เจริญสุข',status:'pending',at:null,actor:null}]", "openModal('doaCalib',{id:'A4'})"],
      "container": "#modalBackdrop .modal",
      "target": { "selector": "#btnCalibStage", "has_text": "บันทึกผลสอบทานขั้น" } },

    { "key": "doa_final",
      "setup": ["state.tab='review';render()", "appr('A4').approvals=[{no:1,role:'หัวหน้าสายงาน',personId:'x1',personName:'ประสงค์ ชัยมงคล',status:'done',at:'2026-09-09 10:00',actor:'สุนิสา คำแก้ว'},{no:2,role:'ผู้สอบทาน (HRBP/ผู้บริหาร)',personId:'x2',personName:'วิชัย เจริญสุข',status:'current',at:null,actor:null}]", "openModal('doaCalib',{id:'A4'})"],
      "container": "#modalBackdrop .modal",
      "target": { "selector": "#p_dec" } },

    { "key": "result_hooks",
      "setup": ["state.tab='review';render()"],
      "container": "#view",
      "target": { "selector": "button", "has_text": "ส่งไปอบรม" } },

    { "key": "pip_modal",
      "setup": ["state.tab='review';render()", "openModal('pip',{id:'A6'})"],
      "container": "#modalBackdrop .modal",
      "target": { "selector": ".modal-title", "has_text": "เปิดแผนพัฒนา" } },

    { "key": "reopen_modal",
      "setup": ["state.tab='review';render()", "openModal('reopen',{id:'A5'})"],
      "container": "#modalBackdrop .modal",
      "target": { "selector": "#reopenReason" } },

    { "key": "history_tab",
      "setup": ["openAppr('A5')", "state.view.tab='history';render()"],
      "container": "#drawer",
      "target": { "selector": ".tl" } },

    { "key": "overdue_banner",
      "setup": ["state.tab='appr';render()"],
      "container": "#view",
      "target": { "selector": ".note.is-warn", "has_text": "เกินกำหนด" } },

    { "key": "notif_panel",
      "setup": ["toggleNotif()"],
      "container": "#notifPanel",
      "target": { "selector": ".notif-head", "has_text": "การแจ้งเตือน" } },

    { "key": "report_stats",
      "setup": ["state.tab='report';render()"],
      "container": "#view",
      "target": { "selector": ".stats" } },

    { "key": "search_empty",
      "setup": ["state.tab='appr';render()", "state.f.search='zzzzz';refreshView()"],
      "container": "#view",
      "target": { "selector": ".empty-title", "has_text": "ไม่พบแบบประเมินที่ค้นหา" } },

    { "key": "staff_scope",
      "setup": ["setRole('staff')", "state.tab='appr';render()"],
      "container": "#view",
      "target": { "selector": ".table-wrap" } },

    { "key": "staff_review",
      "setup": ["setRole('staff')", "state.tab='review';render()"],
      "container": "#view",
      "target": { "selector": ".hookbox", "has_text": "ยังไม่มีผลที่เผยแพร่" } },

    { "key": "mgr_scope",
      "setup": ["setRole('mgr')", "state.tab='appr';render()"],
      "container": "#view",
      "target": { "selector": ".table-wrap" } },

    { "key": "published_kpi",
      "setup": ["openAppr('A5')", "state.view.tab='kpi';render()"],
      "container": "#drawer",
      "target": { "selector": ".kpitbl" } }
  ]
}
