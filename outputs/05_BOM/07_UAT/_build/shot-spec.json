{
  "html":"f-bom.html",
  "route":"#/bom",
  "vw":1200,
  "vh":1000,
  "device_scale":2,
  "shots":[
    {"key":"list_search","setup":[],"container":"#page-content","target":{"selector":".page-h"}},
    {"key":"list_filter","setup":[],"container":"#page-content","target":{"selector":".filter-bar"}},
    {"key":"list_empty","setup":["state.filters.search='NO-SUCH-BOM-999';render()"],"container":"#page-content","target":{"selector":".empty","has_text":"ไม่พบสูตรการผลิต"}},
    {"key":"list_table","setup":[],"container":"#page-content","target":{"selector":".table-card"}},
    {"key":"create_info","setup":["openForm('create',null);render()"],"container":".drawer-panel","target":{"selector":".fsec","has_text":"ข้อมูลสูตร"}},
    {"key":"create_step2","setup":["openForm('create',null);state.form.parent='FG-1005';state.form.ver='v9';state.form.name='สูตรทดสอบ';state.drawer.step=2;render()"],"container":".drawer-panel","target":{"selector":".stepper"}},
    {"key":"create_lines","setup":["openForm('create',null);state.form.parent='FG-1005';state.form.ver='v9';state.form.name='สูตรทดสอบ';state.drawer.step=2;render()"],"container":".drawer-panel","target":{"selector":".lines"}},
    {"key":"create_footer","setup":["openForm('create',null);state.form.parent='FG-1005';state.form.ver='v9';state.form.name='สูตรทดสอบ';state.drawer.step=2;render()"],"container":".drawer-panel","target":{"selector":".drawer-foot"}},
    {"key":"view_overview","setup":["openView('b1');render()"],"container":".drawer-panel","target":{"selector":".dfields"}},
    {"key":"view_versions","setup":["openView('b1');render()"],"container":".drawer-panel","target":{"selector":".fsec","has_text":"เวอร์ชันอื่นของสินค้านี้"}},
    {"key":"status_menu","setup":["openView('b1');render()","toggleStatusMenu({stopPropagation:function(){}})"],"container":".drawer-panel","target":{"selector":"#statusMenu"}},
    {"key":"bulk_bar","setup":["state.bulkSel={'b1':true,'b2':true};render()"],"container":"#page-content","target":{"selector":".bulkbar"}},
    {"key":"delete_modal","setup":["state.bulkSel={'b1':true,'b2':true};openBulkDelete()"],"container":"#modal-root","target":{"selector":".modal"}}
  ]
}
