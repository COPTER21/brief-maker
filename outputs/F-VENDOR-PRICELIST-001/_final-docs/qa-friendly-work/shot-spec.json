{
  "html": "vendor-price-list-v6.html",
  "route": "#/vendor-price-list",
  "vw": 1440,
  "vh": 1000,
  "device_scale": 2,
  "shots": [
    {
      "key": "list_page",
      "setup": [],
      "container": "#page-content",
      "target": { "selector": ".ph", "has_text": "รายการราคาคู่ค้า" }
    },
    {
      "key": "vendor_page",
      "setup": ["location.hash='#/vendor-price-list/vendor/00000000-0000-4000-8000-000000000001'; render()"],
      "container": "#page-content",
      "target": { "selector": ".ph", "has_text": "บริษัท สตีลโปร จำกัด" }
    },
    {
      "key": "batch_page",
      "setup": ["location.hash='#/vendor-price-list/batch'; render()"],
      "container": "#page-content",
      "target": { "selector": ".batch-table" }
    },
    {
      "key": "compare_page",
      "setup": ["location.hash='#/vendor-price-list/compare'; render()"],
      "container": "#page-content",
      "target": { "selector": ".compare-controls" }
    },
    {
      "key": "create_step1",
      "setup": ["openDrawer('create')"],
      "container": "#drawer",
      "target": { "selector": ".form-section", "has_text": "คู่ค้าและสินค้า" }
    },
    {
      "key": "create_step2",
      "setup": ["openDrawer('create'); state.drawer.vendorId='00000000-0000-4000-8000-000000000001'; state.drawer.productId='20000000-0000-4000-8000-000000000002'; state.drawer.uom='BOX'; state.drawer.currency='THB'; state.drawer.tax='VAT7'; state.drawer.step=2; renderDrawer()"],
      "container": "#drawer",
      "target": { "selector": ".form-section", "has_text": "สรุปก่อนส่ง" }
    },
    {
      "key": "view_drawer",
      "setup": ["openDrawer('view','VPL-001')"],
      "container": "#drawer",
      "target": { "selector": ".drawer-title-row" }
    },
    {
      "key": "import_modal",
      "setup": ["openImport()"],
      "container": "#modalEl",
      "target": { "selector": ".import-shell" }
    },
    {
      "key": "reject_modal",
      "setup": ["openConfirm('reject','VPL-002')"],
      "container": "#modalEl",
      "target": { "selector": ".modal-title", "has_text": "ปฏิเสธราคาฉบับนี้หรือไม่?" }
    },
    {
      "key": "deactivate_modal",
      "setup": ["openConfirm('deactivate','VPL-001')"],
      "container": "#modalEl",
      "target": { "selector": ".modal-title", "has_text": "ปิดใช้งานรายการราคา?" }
    }
  ]
}
