{
 "html": "consent-pdpa.html",
 "route": "#/consent/registry",
 "vw": 1360,
 "vh": 1000,
 "device_scale": 2,
 "shots": [
  { "key": "reg_list",
    "setup": ["navigate('consent/registry')", "render()"],
    "wait": 350,
    "container": "#page-content",
    "target": { "selector": "#regTable" } },

  { "key": "reg_near",
    "setup": ["navigate('consent/registry')", "state.filters.status='near'", "render()"],
    "wait": 350,
    "container": "#page-content",
    "target": { "selector": ".stat", "has_text": "ใกล้หมดอายุ" } },

  { "key": "reg_evidence",
    "setup": ["navigate('consent/registry')", "render()", "openConsentView('CNS-5001')"],
    "wait": 420,
    "container": "#drawer",
    "target": { "selector": ".drawer-body" } },

  { "key": "reg_timeline",
    "setup": ["navigate('consent/registry')", "render()", "openConsentView('CNS-5004')"],
    "wait": 420,
    "container": "#drawer",
    "target": { "selector": ".drawer-body" } },

  { "key": "reg_withdraw_modal",
    "setup": ["navigate('consent/registry')", "render()", "openConsentView('CNS-5001')", "openModal('withdraw',{id:'CNS-5001'})"],
    "wait": 420,
    "container": ".modal",
    "target": { "selector": ".modal-body" } },

  { "key": "reg_c360",
    "setup": ["navigate('consent/registry')", "render()", "openC360('CUS-1002')"],
    "wait": 420,
    "container": "#drawer",
    "target": { "selector": ".drawer-body" } },

  { "key": "pur_list",
    "setup": ["setPersona('dpo')", "navigate('consent/purposes')", "render()"],
    "wait": 350,
    "container": "#page-content",
    "target": { "selector": ".table" } },

  { "key": "pur_list_officer",
    "setup": ["setPersona('officer')", "navigate('consent/purposes')", "render()"],
    "wait": 350,
    "container": "#page-content",
    "target": { "selector": ".chip", "has_text": "เฉพาะ DPO" } },

  { "key": "pur_create",
    "setup": ["setPersona('dpo')", "navigate('consent/purposes')", "render()", "openPurCreate()"],
    "wait": 420,
    "container": "#drawer",
    "target": { "selector": ".drawer-body" } },

  { "key": "pur_view",
    "setup": ["setPersona('dpo')", "navigate('consent/purposes')", "render()", "openPurView('PUR-01')"],
    "wait": 420,
    "container": "#drawer",
    "target": { "selector": ".drawer-body" } },

  { "key": "pur_version_modal",
    "setup": ["setPersona('dpo')", "navigate('consent/purposes')", "render()", "openPurView('PUR-01')", "openNewVersion('PUR-01')"],
    "wait": 420,
    "container": ".modal",
    "target": { "selector": ".modal-body" } },

  { "key": "pur_close_modal",
    "setup": ["setPersona('dpo')", "navigate('consent/purposes')", "render()", "openPurView('PUR-02')", "openModal('close-purpose',{code:'PUR-02'})"],
    "wait": 420,
    "container": ".modal",
    "target": { "selector": ".modal-body" } },

  { "key": "pur_doc_viewer",
    "setup": ["setPersona('dpo')", "navigate('consent/purposes')", "render()", "openPurView('PUR-01')", "viewPolicy('PUR-01')"],
    "wait": 420,
    "container": ".modal",
    "target": { "selector": ".doc-frame" } },

  { "key": "req_list",
    "setup": ["setPersona('officer')", "navigate('consent/requests')", "render()"],
    "wait": 350,
    "container": "#page-content",
    "target": { "selector": ".btn-primary", "has_text": "สร้างคำขอ" } },

  { "key": "req_create",
    "setup": ["setPersona('officer')", "navigate('consent/requests')", "render()", "openReqCreate({})"],
    "wait": 450,
    "container": "#drawer",
    "target": { "selector": ".drawer-body" } },

  { "key": "req_view",
    "setup": ["setPersona('officer')", "navigate('consent/requests')", "render()", "openReqView('REQ-2601')"],
    "wait": 450,
    "container": "#drawer",
    "target": { "selector": ".drawer-body" } },

  { "key": "recipient",
    "setup": ["setPersona('officer')", "navigate('consent/requests')", "render()", "openRecipientView('REQ-2601')"],
    "wait": 500,
    "container": "#recipientRoot",
    "target": { "selector": "#recipientRoot" } },

  { "key": "resolve_empty",
    "setup": ["navigate('consent/resolve')", "render()"],
    "wait": 350,
    "container": "#page-content",
    "target": { "selector": ".rz-empty" } },

  { "key": "resolve_granted",
    "setup": ["navigate('consent/resolve')", "state.rz.subject='CUS-1001'", "state.rz.purpose='PUR-01'", "state.rz.channel='email'", "runResolve()"],
    "wait": 400,
    "container": "#page-content",
    "target": { "selector": ".rz-result" } },

  { "key": "resolve_never",
    "setup": ["navigate('consent/resolve')", "state.rz.subject='CUS-1008'", "state.rz.purpose='PUR-03'", "state.rz.channel='phone'", "runResolve()"],
    "wait": 400,
    "container": "#page-content",
    "target": { "selector": ".rz-result" } },

  { "key": "req_answered",
    "setup": ["setPersona('officer')", "navigate('consent/requests')", "render()", "openReqView('REQ-2603')"],
    "wait": 450,
    "container": "#drawer",
    "target": { "selector": ".drawer-body" } },

  { "key": "recipient_closed",
    "setup": ["setPersona('officer')", "navigate('consent/requests')", "render()", "openRecipientView('REQ-2603')"],
    "wait": 500,
    "container": "#recipientRoot",
    "target": { "selector": "#recipientRoot" } },

  { "key": "req_list_auditor",
    "setup": ["setPersona('auditor')", "navigate('consent/requests')", "render()"],
    "wait": 350,
    "container": "#page-content",
    "target": { "selector": ".table" } }
 ]
}
