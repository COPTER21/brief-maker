{
  "html": "TaxCode.html",
  "route": "#/accounting/setup/tax-codes",
  "vw": 1280,
  "vh": 1120,
  "device_scale": 2,
  "shots": [
    { "key": "list_overview", "setup": [], "container": "#page-content",
      "target": { "selector": ".stat", "has_text": "รหัสทั้งหมด" } },
    { "key": "list_kpi", "setup": [], "container": "#page-content",
      "target": { "selector": ".stat", "has_text": "พร้อมใช้วันนี้" } },
    { "key": "list_attention", "setup": [], "container": "#page-content",
      "target": { "selector": ".stat", "has_text": "ร่าง / ปิดใช้งาน" } },
    { "key": "list_tabs", "setup": [], "container": "#page-content",
      "target": { "selector": ".drawer-tab", "has_text": "หัก ณ ที่จ่าย (WHT)" } },
    { "key": "list_table", "setup": [], "container": "#page-content",
      "target": { "selector": "thead" } },
    { "key": "list_search", "setup": [], "container": "#page-content",
      "target": { "selector": ".input-search" } },
    { "key": "list_toolbar", "setup": [], "container": "#page-content",
      "target": { "selector": ".filter-bar" } },
    { "key": "list_actions", "setup": [], "container": "#page-content",
      "target": { "selector": ".btn", "has_text": "สร้างรหัสภาษี" } },
    { "key": "create_form", "setup": ["openDrawer('create')"], "container": "#drawer",
      "target": { "selector": ".field", "has_text": "ตระกูลภาษี" } },
    { "key": "create_form_wht", "setup": ["openDrawer('create')", "onFamilyChange('WHT')"], "container": "#drawer",
      "target": { "selector": ".field", "has_text": "ประเภทเงินได้" } },
    { "key": "view_drawer", "setup": ["openDrawer('view','TX-01')"], "container": "#drawer",
      "target": { "selector": ".def-v", "has_text": "ภาษีมูลค่าเพิ่ม (VAT)" } },
    { "key": "view_wht", "setup": ["openDrawer('view','TX-07')"], "container": "#drawer",
      "target": { "selector": ".def-v", "has_text": "เลือกจากผู้รับเงิน" } },
    { "key": "view_audit", "setup": ["openDrawer('view','TX-01')"], "container": "#drawer",
      "target": { "selector": ".drawer-section-title", "has_text": "ประวัติการเปลี่ยนแปลง" } },
    { "key": "edit_locked", "setup": ["openDrawer('edit','TX-01')"], "container": "#drawer",
      "target": { "selector": ".btn", "has_text": "สร้างรหัสแทน" } },
    { "key": "picker_sales", "setup": ["openModal('picker')"], "container": ".modal",
      "target": { "selector": ".pick-group-title", "has_text": "VAT ที่ใช้ได้" } },
    { "key": "picker_purchase", "setup": ["openModal('picker')", "setPickerContext('PURCHASE')"], "container": ".modal",
      "target": { "selector": ".pill", "has_text": "แนะนำ · ยืนยันตอนจ่าย" } },
    { "key": "picker_payment", "setup": ["openModal('picker')", "setPickerContext('PAYMENT')"], "container": ".modal",
      "target": { "selector": ".modal-body" } },
    { "key": "deactivate_modal", "setup": ["openModal('deactivate',{id:'TX-01'})"], "container": ".modal",
      "target": { "selector": ".modal", "has_text": "ปิดใช้งานรหัสภาษี?" } },
    { "key": "archive_modal", "setup": ["openModal('archiveDraft',{id:'TX-09'})"], "container": ".modal",
      "target": { "selector": ".modal", "has_text": "เก็บร่างถาวร?" } }
  ]
}
