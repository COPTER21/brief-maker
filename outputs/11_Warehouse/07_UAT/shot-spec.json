{
 "html": "WarehouseBin.html",
 "vw": 1300,
 "vh": 1000,
 "device_scale": 2,
 "shots": [
  { "key": "list_kpi", "setup": [], "container": "#page-content", "target": { "selector": ".stats" } },
  { "key": "list_switch", "setup": [], "container": "#page-content", "target": { "selector": ".view-switch" } },
  { "key": "list_card", "setup": [], "container": "#page-content", "target": { "selector": ".card" } },
  { "key": "header_crumb", "setup": [], "container": ".main", "target": { "selector": ".breadcrumb" } },
  { "key": "wh_form", "setup": ["openNodeCreate('warehouse')"], "container": "#drawer", "target": { "selector": ".dw-head" } },
  { "key": "zone_form", "setup": ["drillInto('warehouse','WH-01')", "openNodeCreate('zone')"], "container": "#drawer", "target": { "selector": ".dw-head" } },
  { "key": "area_form", "setup": ["drillInto('warehouse','WH-01')", "drillInto('zone','Z-STORAGE')", "openNodeCreate('area')"], "container": "#drawer", "target": { "selector": ".dw-head" } },
  { "key": "rack_form", "setup": ["drillInto('warehouse','WH-01')", "drillInto('zone','Z-STORAGE')", "drillInto('area','A-AISLE-A')", "openNodeCreate('rack')"], "container": "#drawer", "target": { "selector": ".dw-head" } },
  { "key": "loc_step1", "setup": ["openLocCreate('rack','R-A01')"], "container": "#drawer", "target": { "selector": ".dw-head" } },
  { "key": "loc_step2", "setup": ["openLocCreate('rack','R-A01')", "state.drawer.step=2", "render()"], "container": "#drawer", "target": { "selector": ".dw-head" } },
  { "key": "bulk_form", "setup": ["drillInto('warehouse','WH-01')", "drillInto('zone','Z-STORAGE')", "drillInto('area','A-AISLE-A')", "openBulk()"], "container": "#drawer", "target": { "selector": ".dw-head" } },
  { "key": "view_node", "setup": ["openViewNode('warehouse','WH-01')"], "container": "#drawer", "target": { "selector": ".dw-head" } },
  { "key": "view_loc", "setup": ["openViewLoc('L001')"], "container": "#drawer", "target": { "selector": ".dw-head" } },
  { "key": "modal_archive_block", "setup": ["openModal('delete-node',{kind:'warehouse',id:'WH-01'})"], "container": ".modal", "target": { "selector": ".modal-body" } },
  { "key": "modal_decom_block", "setup": ["openModal('decommission',{id:'L003'})"], "container": ".modal", "target": { "selector": ".modal-body" } },
  { "key": "modal_decom_ok", "setup": ["openModal('decommission',{id:'L010'})"], "container": ".modal", "target": { "selector": ".modal-body" } },
  { "key": "modal_block", "setup": ["openModal('block',{id:'L010'})"], "container": ".modal", "target": { "selector": ".modal-body" } }
 ]
}
