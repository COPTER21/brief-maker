{
  "html": "F-ACC-CN_credit-note.html",
  "vw": 1300,
  "vh": 920,
  "device_scale": 2,
  "shots": [
    { "key": "list_stats", "setup": [], "wait": 500, "container": "#page-content", "target": { "selector": ".stat-row" } },
    { "key": "list_table", "setup": [], "wait": 500, "container": "#page-content", "target": { "selector": ".table-wrap" } },
    { "key": "list_toolbar", "setup": [], "wait": 500, "container": "#page-content", "target": { "selector": ".toolbar" } },
    { "key": "list_actions", "setup": [], "wait": 500, "container": "#page-content", "target": { "selector": ".ph-actions" } },

    { "key": "create_s1", "setup": ["location.hash='#/create'"], "wait": 550, "container": "#create-drawer", "target": { "selector": "button", "has_text": "ลดหนี้ไม่อ้างใบ" } },
    { "key": "create_s1_table", "setup": ["location.hash='#/create'"], "wait": 550, "container": "#create-drawer", "target": { "selector": "#src-rows" } },

    { "key": "create_s2", "setup": ["location.hash='#/create'", "pickInv('INV-2026-0140'); createWizard.step=2; renderCreateDrawer();"], "wait": 500, "container": "#create-drawer", "target": { "selector": ".form-grid" } },
    { "key": "create_s2_reason", "setup": ["location.hash='#/create'", "pickInv('INV-2026-0140'); createWizard.step=2; renderCreateDrawer();"], "wait": 500, "container": "#create-drawer", "target": { "selector": "#f-reason" } },
    { "key": "create_s2_sr", "setup": ["location.hash='#/create'", "pickInv('INV-2026-0140'); createWizard.data.reason='RET'; buildLinesFromInv(createWizard.data); createWizard.step=2; renderCreateDrawer();"], "wait": 500, "container": "#create-drawer", "target": { "selector": "#f-sr" } },
    { "key": "create_s2_disc", "setup": ["location.hash='#/create'", "pickInv('INV-2026-0137'); setReason('DISC'); createWizard.step=2; renderCreateDrawer();"], "wait": 500, "container": "#create-drawer", "target": { "selector": "#f-reason" } },

    { "key": "create_s3_lines", "setup": ["location.hash='#/create'", "pickInv('INV-2026-0140'); createWizard.step=3; renderCreateDrawer();"], "wait": 500, "container": "#create-drawer", "target": { "selector": ".line-meta" } },
    { "key": "create_s3_endbill", "setup": ["location.hash='#/create'", "pickInv('INV-2026-0140'); createWizard.step=3; createWizard.data.endbill.enabled=true; createWizard.data.endbill.mode='amount'; createWizard.data.endbill.value=1000; renderCreateDrawer();"], "wait": 500, "container": "#create-drawer", "target": { "selector": "div", "has_text": "ลดได้สูงสุด" } },

    { "key": "create_s5_review", "setup": ["location.hash='#/create'", "pickInv('INV-2026-0140'); createWizard.step=5; renderCreateDrawer();"], "wait": 500, "container": "#create-drawer", "target": { "selector": "div", "has_text": "สายอนุมัติ (DOA" } },
    { "key": "create_s5_doa_t3", "setup": ["location.hash='#/create'", "pickInv('INV-2026-0141'); createWizard.step=5; renderCreateDrawer();"], "wait": 500, "container": "#create-drawer", "target": { "selector": "div", "has_text": "สายอนุมัติ (DOA" } },

    { "key": "s4_attach", "setup": ["location.hash='#/create'", "pickInv('INV-2026-0140'); createWizard.step=4; renderCreateDrawer();"], "wait": 500, "container": "#create-drawer", "target": { "selector": ".upload-zone" } },

    { "key": "submit_modal", "setup": ["location.hash='#/view/R6'", "openSubmitModal('R6');"], "wait": 550, "container": "#submit-modal", "target": { "selector": ".slot-row" } },

    { "key": "view_detail", "setup": ["location.hash='#/view/R1'"], "wait": 550, "container": "#view-drawer", "target": { "selector": "#view-drawer h2" } },
    { "key": "view_tabs", "setup": ["location.hash='#/view/R1'"], "wait": 550, "container": "#view-drawer", "target": { "selector": "#view-drawer .tabs" } },
    { "key": "view_actions_draft", "setup": ["location.hash='#/view/R6'"], "wait": 550, "container": "#view-drawer", "target": { "selector": "button", "has_text": "ส่งอนุมัติ" } },
    { "key": "view_actions_approved", "setup": ["location.hash='#/view/R2'"], "wait": 550, "container": "#view-drawer", "target": { "selector": "button", "has_text": "ส่งให้ลูกค้า" } },

    { "key": "view_ref", "setup": ["location.hash='#/view/R1'", "viewState.tab='ref'; renderViewDrawer();"], "wait": 500, "container": "#view-drawer", "target": { "selector": "div", "has_text": "ผลกระทบภาษีขาย" } },
    { "key": "view_ref_je", "setup": ["location.hash='#/view/R1'", "viewState.tab='ref'; renderViewDrawer();"], "wait": 500, "container": "#view-drawer", "target": { "selector": "div", "has_text": "รายการบัญชี" } },

    { "key": "view_sign", "setup": ["location.hash='#/view/R5'", "viewState.tab='sign'; renderViewDrawer();"], "wait": 500, "container": "#view-drawer", "target": { "selector": "div", "has_text": "ลำดับการอนุมัติ" } },
    { "key": "view_sign_approve", "setup": ["switchPersona(1)", "location.hash='#/view/R4'", "viewState.tab='sign'; renderViewDrawer();"], "wait": 550, "container": "#view-drawer", "target": { "selector": "button", "has_text": "อนุมัติ" } },

    { "key": "view_history", "setup": ["location.hash='#/view/R1'", "viewState.tab='history'; renderViewDrawer();"], "wait": 500, "container": "#view-drawer", "target": { "selector": "div", "has_text": "ประวัติ (append-only)" } },
    { "key": "view_pdf", "setup": ["location.hash='#/view/R1'", "viewState.tab='pdf'; renderViewDrawer();"], "wait": 500, "container": "#view-drawer", "target": { "selector": ".a4" } },

    { "key": "reject_modal", "setup": ["switchPersona(1)", "location.hash='#/view/R4'", "openRejectModal('R4');"], "wait": 550, "container": ".modal-overlay .card", "target": { "selector": "#md-reason" } },
    { "key": "cancel_modal", "setup": ["location.hash='#/view/R6'", "openCancelCN('R6');"], "wait": 550, "container": ".modal-overlay .card", "target": { "selector": "#md-reason" } }
  ]
}
